{
  "name": "@khatiwadaprashant/zipit-core",
  "version": "0.1.1",
  "description": "High-performance client-side ZIP streaming and resumable batch download engine",
  "license": "MIT",
  "author": "Prashant Khatiwada",
  "keywords": [
    "download",
    "zip",
    "streaming",
    "browser",
    "opfs",
    "file-system-access",
    "indexeddb",
    "resumable",
    "batch-download"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/workers/download.worker.d.ts",
      "import": "./dist/workers/download.worker.js",
      "require": "./dist/workers/download.worker.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "streamsaver": "^2.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "fflate": "^0.8.0"
  }
}
